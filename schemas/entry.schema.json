{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phlxxx.github.io/lost-desktop-museum-community/schemas/entry.schema.json",
  "title": "CommunityCatalogEntry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "caseId", "version", "publisherId", "title", "summary", "language", "additionalLanguages", "difficulty", "estimatedMinutes", "tags", "contentRating", "contentWarnings", "engineCompatibility", "packageFile", "changelogFile", "screenshotFiles", "license", "distributionConsent", "saveCompatibility", "status", "moderation", "publishedAt", "updatedAt"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "caseId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
    "version": { "type": "string", "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?$" },
    "publisherId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,38}[a-z0-9]$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "subtitle": { "type": "string", "maxLength": 180 },
    "summary": { "type": "string", "minLength": 20, "maxLength": 800 },
    "language": { "type": "string", "minLength": 2 },
    "additionalLanguages": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "difficulty": { "enum": ["easy", "normal", "hard"] },
    "estimatedMinutes": { "type": "object", "additionalProperties": false, "required": ["min", "max"], "properties": { "min": { "type": "integer", "minimum": 5 }, "max": { "type": "integer", "minimum": 5 } } },
    "tags": { "type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 30 } },
    "contentRating": { "enum": ["general", "teen", "mature"] },
    "contentWarnings": { "type": "array", "items": { "type": "string", "maxLength": 120 } },
    "engineCompatibility": { "$ref": "#/$defs/engine" },
    "packageFile": { "$ref": "#/$defs/path" },
    "changelogFile": { "$ref": "#/$defs/path" },
    "screenshotFiles": { "type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true, "items": { "$ref": "#/$defs/path" } },
    "license": { "type": "object", "additionalProperties": false, "required": ["name"], "properties": { "name": { "type": "string", "minLength": 1 }, "url": { "type": "string", "pattern": "^https://" }, "customTextFile": { "$ref": "#/$defs/path" } } },
    "distributionConsent": { "const": true },
    "saveCompatibility": { "type": "object", "additionalProperties": false, "required": ["mode", "compatibleFromVersions"], "properties": { "mode": { "enum": ["compatible", "requires-review", "incompatible"] }, "compatibleFromVersions": { "type": "array", "items": { "type": "string" } }, "notes": { "type": "string", "maxLength": 1000 } } },
    "status": { "enum": ["active", "deprecated", "blocked"] },
    "moderation": { "type": "object", "additionalProperties": false, "required": ["automatedValidationRequired", "curated", "featured"], "properties": { "automatedValidationRequired": { "const": true }, "curated": { "type": "boolean" }, "featured": { "type": "boolean" }, "notes": { "type": "string", "maxLength": 1000 } } },
    "publishedAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "path": { "type": "string", "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*://)[A-Za-z0-9._/-]+$" },
    "engine": { "type": "object", "additionalProperties": false, "required": ["minimum"], "properties": { "minimum": { "type": "string" }, "maximumExclusive": { "type": "string" } } }
  }
}
