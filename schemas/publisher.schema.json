{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phlxxx.github.io/lost-desktop-museum-community/schemas/publisher.schema.json",
  "title": "CommunityPublisher",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "publisherId", "displayName", "description", "languages", "links", "joinedAt", "status"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "publisherId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,38}[a-z0-9]$" },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 80 },
    "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "githubUsername": { "type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$" },
    "repositoryUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
    "avatarPath": { "type": "string", "pattern": "^(?!/)(?!.*\\.\\.).+" },
    "languages": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 2 } },
    "links": { "type": "array", "items": { "$ref": "#/$defs/link" } },
    "joinedAt": { "type": "string", "format": "date-time" },
    "status": { "enum": ["active", "suspended"] }
  },
  "$defs": {
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "url"],
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 40 },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" }
      }
    }
  }
}
